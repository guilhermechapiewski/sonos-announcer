#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.9"
# dependencies = ["soco>=0.30"]
# ///
"""Announce a spoken message (or play a sound) on Sonos speakers.

Text is rendered with macOS `say`, served from a short-lived local HTTP
server, played on the target speakers, and then whatever was playing
before is restored (track, position, volume).

Examples:
  sonos-announce "Dinner is ready"
  sonos-announce -r kitchen,"living room" -v 40 "Leaving in 5 minutes"
  sonos-announce --all -V Samantha "Good night"
  echo "Build finished" | sonos-announce -r Office
  sonos-announce --sound ~/chime.mp3 -r Office
  sonos-announce --list
  sonos-announce --setup              # change default rooms (~/.sonos-announce)
"""

import argparse
import functools
import json
import http.server
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
import wave


import soco
from soco.snapshot import Snapshot

CONFIG_PATH = os.path.expanduser("~/.sonos-announce")
CONFIG_ENV_ROOM = "SONOS_ANNOUNCE_ROOM"      # default room(s), comma separated
CONFIG_ENV_VOLUME = "SONOS_ANNOUNCE_VOLUME"  # default announcement volume
CONFIG_ENV_VOICE = "SONOS_ANNOUNCE_VOICE"    # default `say` voice


def die(msg):
    print(f"sonos-announce: {msg}", file=sys.stderr)
    sys.exit(1)


def discover(timeout=5):
    speakers = soco.discover(timeout=timeout) or set()
    if not speakers:
        die("no Sonos speakers found on the network")
    return sorted(speakers, key=lambda s: s.player_name.lower())


def load_config():
    try:
        with open(CONFIG_PATH) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        die(f"cannot read {CONFIG_PATH}: {e} (fix it or run --setup)")
    if cfg.get("mode") not in ("all", "rooms", "ask"):
        die(f"invalid mode in {CONFIG_PATH} (run --setup)")
    return cfg


def save_config(cfg):
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")


class Tty:
    """The controlling terminal, for prompts even when stdin is a pipe.

    Opened as separate read and write handles: open("/dev/tty", "r+") fails
    on macOS because a terminal isn't seekable."""

    def __init__(self):
        self._in = open("/dev/tty")
        try:
            self._out = open("/dev/tty", "w")
        except OSError:
            self._in.close()
            raise

    def write(self, s):
        self._out.write(s)

    def flush(self):
        self._out.flush()

    def readline(self):
        return self._in.readline()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self._in.close()
        self._out.close()


def open_tty():
    try:
        return Tty()
    except OSError:  # no controlling terminal (cron, launchd, ...)
        return None


NO_TTY_HELP = "pass -r ROOM (or --all), or run --setup in a terminal to save a default"


def ask(tty, question):
    tty.write(question)
    tty.flush()
    answer = tty.readline()
    if not answer:  # EOF / Ctrl-D
        raise KeyboardInterrupt
    return answer.strip()


def pick_rooms(tty, speakers):
    """Let the user choose rooms by number. Returns names, or None for all."""
    tty.write("\nSonos rooms:\n")
    for i, s in enumerate(speakers, 1):
        tty.write(f"  {i}) {s.player_name}\n")
    while True:
        answer = ask(tty, "Rooms (e.g. 1,3 — or 'a' for all): ").lower()
        if answer in ("a", "all"):
            return None
        try:
            idx = [int(x) for x in answer.replace(",", " ").split()]
            if idx and all(1 <= i <= len(speakers) for i in idx):
                return list(dict.fromkeys(speakers[i - 1].player_name for i in idx))
        except ValueError:
            pass
        tty.write("  Please enter room numbers from the list.\n")


def run_setup(tty, speakers):
    tty.write(
        "\nWhere should announcements play?\n"
        "  1) Ask me every time\n"
        "  2) Always the same rooms (choose them now)\n"
        "  3) All rooms\n"
    )
    while True:
        choice = ask(tty, "Choice [1-3]: ")
        if choice in ("1", "2", "3"):
            break
    if choice == "1":
        cfg = {"mode": "ask"}
    elif choice == "3":
        cfg = {"mode": "all"}
    else:
        rooms = pick_rooms(tty, speakers)
        cfg = {"mode": "all"} if rooms is None else {"mode": "rooms", "rooms": rooms}
    save_config(cfg)
    tty.write(f"Saved to {CONFIG_PATH} (run with --setup to change).\n\n")
    return cfg


def choose_rooms(speakers):
    """Rooms from config (running first-time setup if needed). None means all.

    Never falls back to all rooms on its own: that happens only when the
    user picked it (in setup or at the prompt)."""
    if len(speakers) == 1:
        return None
    cfg = load_config()
    if cfg is None:
        tty = open_tty()
        if not tty:
            die(f"found {len(speakers)} rooms and no saved choice; {NO_TTY_HELP}")
        with tty:
            cfg = run_setup(tty, speakers)
    if cfg["mode"] == "rooms":
        if not cfg.get("rooms"):
            die(f"no rooms saved in {CONFIG_PATH}; run --setup")
        return cfg["rooms"]
    if cfg["mode"] == "ask":
        tty = open_tty()
        if not tty:
            die(f"can't ask which room without a terminal; {NO_TTY_HELP}")
        with tty:
            return pick_rooms(tty, speakers)
    return None  # mode "all", chosen explicitly


def find_speaker(speakers, name):
    """Match a room forgivingly: exact name, then prefix, then substring
    (case-insensitive), so `garage` finds "Garage Sonos"."""
    want = name.strip().lower()
    names = [(s.player_name.lower(), s) for s in speakers]
    def short(n):  # "garage sonos" -> "garage"
        return n[: -len(" sonos")] if n.endswith(" sonos") else n

    for match in (lambda n: n == want, lambda n: short(n) == short(want),
                  lambda n: n.startswith(want), lambda n: want in n):
        hits = [s for n, s in names if match(n)]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            die(f"room '{name}' is ambiguous: " + ", ".join(s.player_name for s in hits))
    available = ", ".join(s.player_name for s in speakers)
    die(f"unknown room '{name}'. Available: {available} (saved rooms can be changed with --setup)")


def resolve_targets(speakers, rooms, all_rooms):
    """Return the group coordinators to play on (one per affected group)."""
    if all_rooms or not rooms:
        chosen = speakers
    else:
        chosen = [find_speaker(speakers, r) for r in rooms]

    coords = {}
    for s in chosen:
        c = s.group.coordinator if s.group else s
        coords[c.uid] = c
    return list(coords.values())


def render_speech(text, voice, out_dir):
    if not shutil.which("say"):
        die("macOS `say` not found; use --sound with an audio file instead")
    path = os.path.join(out_dir, "announcement.wav")
    cmd = ["say", "-o", path, "--file-format=WAVE", "--data-format=LEI16@22050"]
    if voice:
        cmd += ["-v", voice]
    cmd.append(text)
    subprocess.run(cmd, check=True)
    with wave.open(path) as w:
        duration = w.getnframes() / float(w.getframerate())
    return path, duration


def local_ip_for(target_ip):
    """The LAN address of this machine as seen from the speaker's network."""
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.connect((target_ip, 1400))
        return s.getsockname()[0]


class AudioHandler(http.server.SimpleHTTPRequestHandler):
    """Static file handler that speaks HTTP Range (Sonos fetches audio in
    byte ranges and often drops the first connection) and stays quiet."""

    def log_message(self, *args):
        pass

    def handle(self):
        try:
            super().handle()
        except (BrokenPipeError, ConnectionResetError):
            pass  # speaker hung up early; it will re-request what it needs

    def end_headers(self):
        self.send_header("Accept-Ranges", "bytes")
        super().end_headers()

    def send_head(self):
        self._remaining = None
        rng = self.headers.get("Range", "")
        m = re.fullmatch(r"\s*bytes=(\d*)-(\d*)\s*", rng)
        path = self.translate_path(self.path)
        if not m or not os.path.isfile(path) or not any(m.groups()):
            return super().send_head()

        size = os.path.getsize(path)
        first, last = m.groups()
        if first == "":  # suffix range: last N bytes
            start, end = max(0, size - int(last)), size - 1
        else:
            start, end = int(first), min(int(last) if last else size - 1, size - 1)
        if start >= size or start > end:
            self.send_response(416)
            self.send_header("Content-Range", f"bytes */{size}")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return None

        f = open(path, "rb")
        f.seek(start)
        self.send_response(206)
        self.send_header("Content-Type", self.guess_type(path))
        self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
        self.send_header("Content-Length", str(end - start + 1))
        self.end_headers()
        self._remaining = end - start + 1
        return f

    def copyfile(self, source, outputfile):
        if self._remaining is None:
            return super().copyfile(source, outputfile)
        while self._remaining > 0:
            buf = source.read(min(64 * 1024, self._remaining))
            if not buf:
                break
            outputfile.write(buf)
            self._remaining -= len(buf)


def start_server(directory):
    handler = functools.partial(AudioHandler, directory=directory)
    server = http.server.ThreadingHTTPServer(("0.0.0.0", 0), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def announce_group(coord, uri, volume, duration, title, stop):
    members = list(coord.group.members) if coord.group else [coord]
    snap = Snapshot(coord)
    snap.snapshot()
    saved_volumes = {m.uid: (m, m.volume) for m in members}

    was_playing = snap.transport_state == "PLAYING"
    try:
        if stop.is_set():
            return
        if was_playing:
            coord.pause()
        if volume is not None:
            for m in members:
                m.volume = volume
        coord.play_uri(uri, title=title)

        # Wait for playback to finish: expected length + slack, polling state.
        # `stop` (set on Ctrl-C) cuts the wait short; restore still runs.
        deadline = time.time() + (duration or 30) + 10
        if stop.wait(1.5):
            return
        while time.time() < deadline:
            state = coord.get_current_transport_info()["current_transport_state"]
            if state in ("STOPPED", "PAUSED_PLAYBACK"):
                break
            if stop.wait(0.5):
                return
    finally:
        try:
            coord.stop()
        except Exception:
            pass
        for m, v in saved_volumes.values():
            try:
                m.volume = v
            except Exception:
                pass
        snap.restore(fade=False)


def cmd_list():
    for s in discover():
        group = s.group
        coord = group.coordinator if group else s
        role = "coordinator" if coord.uid == s.uid else f"in group of {coord.player_name}"
        print(f"{s.player_name:<24} {s.ip_address:<16} vol={s.volume:<3} {role}")


def main():
    p = argparse.ArgumentParser(
        prog="sonos-announce",
        description="Announce a message on Sonos speakers.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Examples:" + __doc__.split("Examples:", 1)[1],
    )
    p.add_argument("message", nargs="*", help="text to speak (reads stdin if omitted)")
    p.add_argument("-r", "--room", "--rooms", dest="room", action="append", default=[],
                   metavar="ROOM",
                   help="room(s) to announce in; repeat or comma-separate, partial names "
                        "OK (e.g. -r garage,family). Default: saved choice from --setup")
    p.add_argument("-a", "--all", action="store_true", help="announce in every room")
    p.add_argument("-v", "--volume", "--vol", dest="volume", type=int, metavar="0-100",
                   default=int(os.environ[CONFIG_ENV_VOLUME]) if os.environ.get(CONFIG_ENV_VOLUME) else None,
                   help="announcement volume (default: keep current)")
    p.add_argument("-V", "--voice", default=os.environ.get(CONFIG_ENV_VOICE),
                   help="macOS voice, e.g. Samantha (list them with: say -v '?')")
    p.add_argument("-s", "--sound", "-f", "--file", dest="sound", metavar="FILE",
                   help="play an audio file (mp3/wav/...) instead of speech")
    p.add_argument("-l", "--list", action="store_true", help="list speakers and exit")
    p.add_argument("-c", "--setup", "--config", dest="setup", action="store_true",
                   help=f"choose default rooms again (saved in {CONFIG_PATH})")
    args = p.parse_args()
    args.room = [r.strip() for arg in args.room for r in arg.split(",") if r.strip()]

    if args.list:
        cmd_list()
        return

    if args.setup:
        tty = open_tty()
        if not tty:
            die("--setup needs an interactive terminal")
        with tty:
            run_setup(tty, discover())
        if not args.message:
            return

    if args.volume is not None and not 0 <= args.volume <= 100:
        die("volume must be between 0 and 100")

    rooms = args.room or [r.strip() for r in os.environ.get(CONFIG_ENV_ROOM, "").split(",") if r.strip()]

    text = " ".join(args.message).strip()
    if not text and not args.sound:
        if sys.stdin.isatty():
            p.error("no message given")
        text = sys.stdin.read().strip()
        if not text:
            p.error("no message given")

    speakers = discover()
    if not rooms and not args.all:
        rooms = choose_rooms(speakers) or []
    targets = resolve_targets(speakers, rooms, args.all)

    with tempfile.TemporaryDirectory(prefix="sonos-announce-") as tmp:
        if args.sound:
            src = os.path.expanduser(args.sound)
            if not os.path.isfile(src):
                die(f"sound file not found: {src}")
            name = "sound" + os.path.splitext(src)[1].lower()
            shutil.copy(src, os.path.join(tmp, name))
            duration = None
            if name.endswith(".wav"):
                with wave.open(os.path.join(tmp, name)) as w:
                    duration = w.getnframes() / float(w.getframerate())
            title = os.path.basename(src)
        else:
            path, duration = render_speech(text, args.voice, tmp)
            name = os.path.basename(path)
            title = "Announcement"

        server = start_server(tmp)
        try:
            port = server.server_address[1]
            host = local_ip_for(targets[0].ip_address)
            uri = f"http://{host}:{port}/{urllib.parse.quote(name)}"

            names = ", ".join(
                " + ".join(m.player_name for m in (c.group.members if c.group else [c]))
                for c in targets)
            status(f"Announcing in {names}...")

            stop = threading.Event()
            errors = {}

            def worker(c):
                try:
                    announce_group(c, uri, args.volume, duration, title, stop)
                except Exception as e:
                    errors[c.player_name] = e

            # Daemon threads, so a second Ctrl-C can always exit immediately.
            threads = [threading.Thread(target=worker, args=(c,), daemon=True) for c in targets]
            for t in threads:
                t.start()
            interrupted = False
            try:
                while any(t.is_alive() for t in threads):
                    for t in threads:
                        t.join(0.2)
            except KeyboardInterrupt:
                interrupted = True
                stop.set()
                status("\nStopping and restoring speakers (Ctrl-C again to force quit)...")
                for t in threads:
                    t.join()
        finally:
            server.shutdown()

    for name, e in errors.items():
        print(f"sonos-announce: {name}: {e}", file=sys.stderr)
    if interrupted:
        sys.exit(130)
    if errors:
        sys.exit(1)
    status("Done.")


def status(msg):
    if sys.stderr.isatty():
        print(msg, file=sys.stderr)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
